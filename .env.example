# Обязательные настройки Telegram
# Если ADMIN_CHAT_ID пуст, бот доступен любому пользователю в личном чате.
BOT_TOKEN=вставьте_токен
ADMIN_CHAT_ID=

# Телефон или логин аккаунта Profi.ru. Нужен для автоматического перевыпуска cookies.
PROFI_LOGIN=+79990000000

# По умолчанию этот прокси используется Telegram, Chromium и восстановлением сессии.
# Оставьте пустым, если прокси не нужен. Пример SOCKS5:
# socks5://127.0.0.1:10808
TELEGRAM_PROXY=
# Если авторизация Profi.ru зависает через общий прокси, укажите direct.
# Также здесь можно задать отдельный прокси только для Chromium.
PROFI_PROXY=

# Настройки Profi.ru и браузера
PROFI_PAGE_URL=https://profi.ru/backoffice/
# На Linux-сервере оставьте true: Chromium работает без графического окна.
HEADLESS=true

# Интервалы в секундах. Без необходимости менять не нужно.
# Умеренная частота запросов с разбросом 90–150 секунд.
POLL_BASE_SEC=90
POLL_JITTER_SEC=60
BOT_POLL_SEC=3
SELECTOR_TIMEOUT_SEC=60
PAGE_TIMEOUT_SEC=90

# true включает подробный журнал решений фильтра
DEBUG_FILTER=false

# Автоматическое восстановление сессии через код из Telegram
SESSION_RECOVERY_ENABLED=true
SESSION_RECOVERY_HEADLESS=true
SMS_CODE_TIMEOUT_SEC=300
# Защита от частых повторных запросов SMS через /renew.
RECOVERY_COOLDOWN_SEC=300

# Уведомление отправляется после такого количества ошибок сайта подряд
SITE_ERROR_THRESHOLD=3
ERROR_BACKOFF_BASE_SEC=60
ERROR_BACKOFF_MAX_SEC=900

# Heartbeat и watchdog
HEARTBEAT_INTERVAL_SEC=30
HEARTBEAT_STALE_SEC=120
SUCCESS_STALE_SEC=900
WATCHDOG_POLL_SEC=30
MIN_FREE_DISK_MB=1024

# Диагностика и автоматическое обслуживание
TRACE_ON_FAILURE=true
DEBUG_RETENTION_DAYS=14
QUEUE_COMPACT_BYTES=1000000
SEEN_IDS_RETENTION_DAYS=180
SEEN_IDS_MAX_COUNT=100000
BACKUP_RETENTION_DAYS=30
